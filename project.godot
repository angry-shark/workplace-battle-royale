; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Workplace Battle Royale"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

Config="*res://autoload/config.gd"
EventBus="*res://autoload/event_bus.gd"
GameManager="*res://autoload/game_manager.gd"
PlayerData="*res://autoload/player_data.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
TooltipManager="*res://scenes/components/tooltip_manager.gd"
CardManager="*res://core/card/card_manager.gd"
HexManager="*res://core/hex/hex_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[input]

